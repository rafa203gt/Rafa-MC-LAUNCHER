{
  "name": "rafa-mc-launcher",
  "version": "1.0.21",
  "description": "Custom Minecraft Launcher with Auto-Modpack Sync and No-Premium support",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:win": "tsc && vite build && electron-builder --win",
    "test": "vitest run --config ./vitest.config.ts",
    "pack-builder": "node scripts/build-manifest.js",
    "publish-pack": "node scripts/publish-modpack.js",
    "sync-mod": "node scripts/update-single-mod.js",
    "release:app": "node scripts/release-app.js",
    "security:check": "node scripts/security-check.js",
    "admin": "npm --prefix admin-panel run dev",
    "admin:build": "npm --prefix admin-panel run build"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "modpack",
    "electron",
    "forge",
    "fabric"
  ],
  "author": "rafa203gt",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "minecraft-launcher-core": "^3.2.33",
    "minecraft-server-util": "^5.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "skinview3d": "^3.4.2",
    "tailwind-merge": "^3.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^1.6.0"
  }
}
